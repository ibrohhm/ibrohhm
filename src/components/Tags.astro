---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<div class="tags">
			{tags.map((tag) => (
				<span class="tag">{tag}</span>
			))}
		</div>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.tag {
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--color-ink);
		background: color-mix(in oklch, var(--color-orange) 30%, transparent);
		padding: 0.3125rem 0.75rem;
		border-radius: 999px;
	}
</style>
