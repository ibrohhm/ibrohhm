---
import ProjectLayout from '../layouts/ProjectLayout.astro';
import { categories, hostLabel, projects, type Project } from '../data/projects';
import { getArticles } from '../lib/articles';

const articleTitles = new Map(getArticles().map((a) => [a.slug, a.title]));
const groups = categories
	.map((category) => ({ category, items: projects.filter((p) => p.category === category) }))
	.filter((g) => g.items.length > 0);

function relatedTitle(project: Project) {
	return project.article ? articleTitles.get(project.article) : undefined;
}
---

<ProjectLayout
	title="Things I've built — Syarif Ibrohim"
	description="Small experiments from learning a language, a pattern or a tool."
>
	<a class="back" href="/">← Back to articles</a>
	<h1>Things I've built</h1>
	<p class="intro">
		Made while learning a language, a pattern or a tool. Most are experiments rather than finished
		products, and a few of the older ones I'd write differently today.
	</p>

	{
		groups.map((group) => (
			<section>
				<h2>
					{group.category} · {group.items.length}
				</h2>
				<ul class="rows">
					{group.items.map((project) => (
						<li>
							<div class="text">
								<a class="name" href={project.url} target="_blank" rel="noopener noreferrer">
									{project.name}
								</a>
								<span class="description">{project.description}</span>
								{relatedTitle(project) && (
									<a class="related" href={`/article/${project.article}`}>
										Related article: {relatedTitle(project)}
									</a>
								)}
							</div>
							<span class="host" aria-hidden="true">{hostLabel(project.url)} ↗</span>
						</li>
					))}
				</ul>
			</section>
		))
	}
</ProjectLayout>

<style>
	.back {
		display: inline-block;
		margin-bottom: 1.25rem;
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
	}

	h1 {
		margin: 0 0 1.125rem;
		font-size: clamp(2rem, 4.2vw, 2.75rem);
		color: var(--color-ink);
	}

	.intro {
		margin: 0 0 1rem;
		font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
		line-height: 1.65;
		color: var(--color-body);
	}

	h2 {
		margin: 2.5rem 0 0;
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--color-amber);
	}

	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.rows li {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
		padding: 1.125rem 0;
	}

	.rows li + li {
		border-top: 1px solid oklch(0.89 0.008 315);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.name {
		font-size: 1.1875rem;
		font-weight: 600;
		color: var(--color-ink);
		text-decoration: none;
	}

	.name:hover {
		color: var(--color-plum);
		text-decoration: underline;
		text-decoration-color: var(--color-orange);
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.description {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-body);
	}

	.related {
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.host {
		flex-shrink: 0;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.9rem;
		color: var(--color-plum);
	}

	@media (max-width: 600px) {
		.rows li {
			gap: 1rem;
		}

		.host {
			font-size: 0.8125rem;
		}
	}
</style>
