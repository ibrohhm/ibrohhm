---
import Tags from './Tags.astro';

interface Props {
	title: string;
	description: string;
	tags: string[];
	readingMinutes: number;
	url: string;
}

const { title, description, tags, readingMinutes, url } = Astro.props;
---

<a class="article-card" href={url}>
	<div class="face">
		<h3>{title}</h3>
		<p class="description">{description}</p>
		<div class="foot">
			<Tags tags={tags} />
			<span class="meta">{readingMinutes} min read</span>
		</div>
	</div>
</a>

<style>
	.article-card {
		display: block;
		position: relative;
		margin: 0.5rem 0 0.5rem 0.25rem;
		color: var(--color-ink);
		text-decoration: none;
	}

	.article-card::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 8px;
		background: var(--color-orange);
		transform: translate(-0.25rem, 0.25rem);
	}

	.face {
		position: relative;
		padding: 1.5rem;
		border: 1px solid oklch(0.9 0.005 315);
		border-radius: 8px;
		background: var(--color-card);
		transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
	}

	.article-card:hover .face {
		transform: translate(0.375rem, -0.375rem);
	}

	.article-card h3 {
		margin: 0 0 0.5rem;
		text-wrap: balance;
	}

	.description {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1rem;
		margin-top: 1.25rem;
	}

	.foot :global(.tags) {
		margin-top: 0;
	}

	.meta {
		margin-left: auto;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		color: var(--color-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.face {
			transition: none;
		}

		.article-card:hover .face {
			transform: none;
		}
	}
</style>
