---
import CardButton from './CardButton.astro';
---

<div class="hero">
	<h1 id="syarif-ibrohim">Syarif Ibrohim</h1>
	<div id="role">Backend Engineer</div>
	<nav class="hero-actions">
		<CardButton href="/articles">Articles</CardButton>
		<CardButton href="/projects">Projects</CardButton>
	</nav>
</div>

<style>
	.hero {
		width: 100%;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		box-sizing: border-box;
	}

	#syarif-ibrohim {
		margin: 0 0 0.5rem;
		letter-spacing: 0.2em;
		opacity: 0;
		animation: hero-in 0.6s ease-out 0.1s forwards;
	}

	#role {
		font-family: var(--font-body);
		font-size: 1.25rem;
		color: var(--color-muted);
		margin: 0;
		letter-spacing: 0.2em;
		opacity: 0;
		animation: hero-in 0.6s ease-out 0.3s forwards;
	}

	.hero-actions {
		display: flex;
		gap: 1.5rem;
		margin-top: 1.5rem;
		opacity: 0;
		animation: hero-in 0.6s ease-out 0.5s forwards;
	}

	@keyframes hero-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#syarif-ibrohim,
		#role,
		.hero-actions {
			animation: none;
			opacity: 1;
		}
	}
</style>
