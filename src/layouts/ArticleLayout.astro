---
import Layout from './Layout.astro';
import Tags from '../components/Tags.astro';
import ArticlePagination from '../components/ArticlePagination.astro';

interface Props {
	title?: string;
	description?: string;
	frontmatter?: { title?: string; description?: string; tags?: string[] };
}

const { title, description, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const pageDescription = description ?? frontmatter?.description;
const tags = frontmatter?.tags ?? [];

const articleModules = import.meta.glob('../pages/article/*.mdx', { eager: true }) as Record<
	string,
	{ frontmatter: { title: string; createdAt: string } }
>;

const sortedArticles = Object.entries(articleModules)
	.map(([path, mod]) => ({
		slug: path.split('/').pop()!.replace(/\.mdx$/, ''),
		title: mod.frontmatter.title,
		createdAt: mod.frontmatter.createdAt,
	}))
	.sort((a, b) => b.createdAt.localeCompare(a.createdAt));

const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop();
const currentIndex = sortedArticles.findIndex((a) => a.slug === currentSlug);
const prevArticle = currentIndex > 0 ? sortedArticles[currentIndex - 1] : null;
const nextArticle =
	currentIndex !== -1 && currentIndex < sortedArticles.length - 1 ? sortedArticles[currentIndex + 1] : null;
---

<Layout title={pageTitle} description={pageDescription} ogType="article" bodyClass="bg-grid bg-grid-fade">
	<div class="article">
		<Tags tags={tags} />
		<slot />
		<ArticlePagination prev={prevArticle} next={nextArticle} />
	</div>
</Layout>

<style>
	.article {
		width: min(90%, 70ch);
		margin: 0 auto;
		padding: 6rem 0;
		font-family: var(--font-body);
		font-size: 1.125rem;
		line-height: 1.7;
		color: var(--color-ink);
	}
</style>

<style is:global>
	.article blockquote {
		margin: 0 0 1.25rem;
		padding: 0;
		font-style: italic;
		color: var(--color-muted);
	}

	.article ul,
	.article ol {
		margin: 0 0 1.25rem;
		padding-left: 1.5rem;
	}

	.article .plantuml {
		text-align: center;
		margin: 2rem 0;
	}

	.article .formula {
		text-align: center;
		font-size: 1.5rem;
		font-weight: 400;
		margin: 2rem 0;
		background-color: var(--color-surface);
		padding: 4px;
	}

	.article code {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.4em;
		border-radius: 4px;
	}

	.article pre {
		padding: 0.75rem 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
		margin: 0 0 1.25rem;
		line-height: 1.4;
		tab-size: 2;
	}

	.article pre code {
		background: none;
		padding: 0;
		font-size: 0.875rem;
	}

	.article img,
	.article svg {
		display: block;
		max-width: 100%;
		margin: 0 auto 1.25rem;
	}
</style>
