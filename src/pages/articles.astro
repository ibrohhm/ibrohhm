---
import ArticleList from '../components/ArticleList.astro';
import ArticleLayout from '../layouts/ArticleLayout.astro';
---

<ArticleLayout title="Articles — Syarif Ibrohim" description="Technical writing on backend engineering, resilience patterns, and observability.">
	<h1>Articles</h1>
	<p class="subtitle">Writing about things I broke, fixed, or learned. Please take a look and enjoy.</p>
	<ArticleList />
</ArticleLayout>

<style>
	.subtitle {
		margin-top: -1.5rem;
		margin-bottom: 3rem;
		color: var(--color-muted);
	}
</style>
