---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<div class="tags">
			{tags.map((tag) => (
				<span class="tag">{tag}</span>
			))}
		</div>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}

	.tag {
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-plum);
		background: var(--color-surface);
		padding: 0.2rem 0.6rem;
	}
</style>
