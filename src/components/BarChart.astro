---
interface Props {
	data: { label: string; value: number }[];
}

const { data } = Astro.props;
const max = Math.max(...data.map((d) => d.value));
const barWidth = 60;
const gap = 20;
const height = 200;
const width = data.length * (barWidth + gap);
---

<svg {width} {height} viewBox={`0 0 ${width} ${height}`}>
	{
		data.map((d, i) => {
			const barHeight = (d.value / max) * (height - 30);
			const x = i * (barWidth + gap);
			const y = height - barHeight - 20;
			return (
				<g>
					<rect x={x} y={y} width={barWidth} height={barHeight} fill="#5b5bd6" rx="4" />
					<text x={x + barWidth / 2} y={height - 5} text-anchor="middle" font-size="12">
						{d.label}
					</text>
					<text x={x + barWidth / 2} y={y - 5} text-anchor="middle" font-size="12">
						{d.value}
					</text>
				</g>
			);
		})
	}
</svg>
