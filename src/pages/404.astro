---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page not found — Syarif Ibrohim"
	description="This page doesn't exist."
	bodyClass="bg-grid bg-grid-fade"
>
	<main class="not-found">
		<p class="code">404</p>
		<h1>Page not found</h1>
		<p class="message">
			That page doesn't exist, or the link is out of date. Sorry about that.
		</p>
		<a class="home-link" href="/">← Back to all articles</a>
	</main>
</Layout>

<style>
	.not-found {
		width: min(760px, 100% - 40px);
		margin: 0 auto;
		padding: 4rem 0 2rem;
		font-family: var(--font-body);
	}

	.code {
		margin: 0 0 0.5rem;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-amber);
	}

	h1 {
		margin: 0 0 1rem;
		font-size: clamp(2rem, 4.2vw, 2.75rem);
		color: var(--color-ink);
	}

	.message {
		margin: 0 0 2rem;
		font-size: 1.125rem;
		line-height: 1.65;
		color: var(--color-body);
	}

	.home-link {
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
	}

	.home-link:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-orange);
	}
</style>
