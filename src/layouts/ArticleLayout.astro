---
import ArticlePagination from '../components/ArticlePagination.astro';
import Tags from '../components/Tags.astro';
import { formatDate, getArticles } from '../lib/articles';
import Layout from './Layout.astro';

interface Props {
	title?: string;
	description?: string;
	frontmatter?: { title?: string; description?: string; tags?: string[] };
}

const { title, description, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title;
const pageDescription = description ?? frontmatter?.description;
const tags = frontmatter?.tags ?? [];

const articles = getArticles();
const currentSlug = Astro.url.pathname.split('/').filter(Boolean).pop();
const currentIndex = articles.findIndex((a) => a.slug === currentSlug);
const current = currentIndex !== -1 ? articles[currentIndex] : undefined;
const prev = currentIndex > 0 ? articles[currentIndex - 1] : null;
const next = current && currentIndex < articles.length - 1 ? articles[currentIndex + 1] : null;
const buildsOn = current?.buildsOn ? articles.find((a) => a.slug === current.buildsOn) : undefined;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	ogType="article"
	bodyClass="bg-grid bg-grid-fade"
	monoFont
>
	<main class="article">
		<a class="back" href="/">← All articles</a>
		<Tags tags={tags} />
		<h1>{pageTitle}</h1>
		{pageDescription && <p class="standfirst">{pageDescription}</p>}
		{
			current && (
				<div class="byline">
					<span>
						Syarif Ibrohim · <time datetime={current.createdAt}>{formatDate(current.createdAt)}</time> ·{' '}
						{current.readingMinutes} min read
					</span>
					{buildsOn && <a href={buildsOn.url}>Builds on: {buildsOn.title} →</a>}
				</div>
			)
		}
		<slot />
		<ArticlePagination prev={prev} next={next} />
	</main>
</Layout>

<style>
	.article {
		width: min(680px, 100% - 40px);
		margin: 0 auto;
		padding: 1.5rem 0 0;
		font-family: var(--font-body);
		font-size: 1.1875rem;
		line-height: 1.75;
		color: oklch(0.27 0.02 315);
	}

	.back {
		display: inline-block;
		margin-bottom: 0.25rem;
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none;
	}

	.article h1 {
		margin: 1.25rem 0 1rem;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.12;
		color: var(--color-ink);
	}

	.standfirst {
		margin: 0 0 1.5rem;
		font-size: clamp(1.125rem, 2vw, 1.3125rem);
		line-height: 1.6;
		color: var(--color-body);
	}

	.byline {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.375rem 1.5rem;
		margin: 0 0 2.25rem;
		padding: 0.875rem 0;
		border-block: 1px solid oklch(0.89 0.008 315);
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-body);
	}

	.byline a {
		font-weight: 500;
		text-decoration: none;
	}

	.byline a:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-orange);
	}

</style>
<style is:global>
	.article blockquote {
		margin: 0 0 1.25rem;
		padding: 0;
		font-style: italic;
		color: var(--color-muted);
	}

	.article ul,
	.article ol {
		margin: 0 0 1.25rem;
		padding-left: 1.5rem;
	}

	.article .plantuml {
		text-align: center;
		margin: 2rem 0;
	}

	.article .formula {
		text-align: center;
		font-size: 1.5rem;
		font-weight: 400;
		margin: 2rem 0;
		background-color: var(--color-surface);
		padding: 4px;
	}

	.article code {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.15em 0.4em;
		border-radius: 4px;
	}

	.article pre {
		padding: 0.75rem 1.25rem;
		border-radius: 8px;
		overflow-x: auto;
		margin: 0 0 1.25rem;
		line-height: 1.4;
		tab-size: 2;
	}

	.article pre code {
		background: none;
		padding: 0;
		font-size: 0.875rem;
	}

	.article img,
	.article svg {
		display: block;
		max-width: 100%;
		margin: 0 auto 1.25rem;
	}
</style>
