---
const path = Astro.url.pathname;
const onArticles = path === '/' || path.startsWith('/article');
const onProjects = path.startsWith('/projects');
---

<header class="site-header">
	<a class="name" href="/">Syarif Ibrohim</a>
	<nav aria-label="Main">
		<a href="/" aria-current={onArticles ? 'page' : undefined}>Articles</a>
		<a href="/projects" aria-current={onProjects ? 'page' : undefined}>Projects</a>
		<a href="https://github.com/ibrohhm" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
	</nav>
</header>

<style>
	.site-header {
		width: min(760px, 100% - 40px);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 2.25rem 0;
		font-family: var(--font-body);
	}

	.name {
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--color-ink);
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 1.75rem;
	}

	nav a {
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--color-ink);
		text-decoration: none;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--color-plum);
	}

	nav a[aria-current='page'] {
		text-decoration: underline;
		text-decoration-color: var(--color-orange);
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
	}

	@media (max-width: 600px) {
		.site-header {
			padding: 1.25rem 0;
		}

		.name {
			font-size: 1rem;
		}

		nav {
			gap: 1rem;
		}

		nav a {
			font-size: 0.875rem;
		}
	}
</style>
