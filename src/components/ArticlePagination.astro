---
interface Link {
	url: string;
	title: string;
}

interface Props {
	prev: Link | null;
	next: Link | null;
}

const { prev, next } = Astro.props;
---

{
	(prev || next) && (
		<nav class="article-nav" aria-label="More articles">
			{prev && (
				<a class="prev" href={prev.url} rel="prev">
					<span class="label">← Previous</span>
					<span class="title">{prev.title}</span>
				</a>
			)}
			{next && (
				<a class="next" href={next.url} rel="next">
					<span class="label">Next →</span>
					<span class="title">{next.title}</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.article-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid oklch(0.89 0.008 315);
		font-family: var(--font-body);
	}

	a {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		text-decoration: none;
	}

	.prev {
		grid-column: 1;
	}

	.next {
		grid-column: 2;
		text-align: right;
	}

	.label {
		font-size: 0.8125rem;
		color: var(--color-muted);
	}

	.title {
		font-size: 1rem;
		line-height: 1.4;
		font-weight: 500;
		color: var(--color-plum);
	}

	a:hover .title {
		text-decoration: underline;
		text-decoration-color: var(--color-orange);
	}

	@media (max-width: 600px) {
		.article-nav {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.next {
			grid-column: 1;
			text-align: left;
		}
	}
</style>
